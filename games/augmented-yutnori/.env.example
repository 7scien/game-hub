# Static frontend build-time URL for the Socket.IO game server.
VITE_ONLINE_SERVER_URL=http://localhost:3001

# Node game server settings.
PORT=3001
HOST=0.0.0.0
ONLINE_ALLOWED_ORIGINS=http://localhost:4173,https://your-pages-domain.example
ONLINE_DATA_FILE=server/data/rooms.json
# Render Free 베타나 테스트 서버는 ONLINE_DATA_FILE=:memory: 로 저장을 끕니다.
# 이 경우 절전·재배포·재시작 후 진행 방이 복원되지 않습니다.
ONLINE_TRUST_PROXY=0
ONLINE_CLEANUP_INTERVAL_MS=60000
ONLINE_EMPTY_ROOM_TTL_MS=300000
ONLINE_FINISHED_ROOM_TTL_MS=7200000
ONLINE_IDLE_ROOM_TTL_MS=43200000

# Render/Railway 등 TLS 프록시 뒤에서는 ONLINE_TRUST_PROXY=1을 사용합니다.
# 영구 볼륨을 연결했다면 예: ONLINE_DATA_FILE=/var/data/rooms.json
