    if(testParams.has('smoke')){(async()=>{try{gameState=makeState([0,1,2,3].map(i=>({name:`P${i+1}`,color:COLORS[i]})));gameState.settings.reducedMotion=true;showGame();const first=activeIndex();await movePlayer(first,2);await resolveLanding(first);gameState.phase='turnEnd';await finishTurn();const saved=JSON.parse(localStorage.getItem(CONFIG.saveKey));const ok=gameState.globalTurn===1&&gameState.phase==='turn'&&saved.globalTurn===1&&gameState.players[first].totalDistance===2;document.documentElement.dataset.forestPartySmoke=ok?'PASS':'FAIL'}catch(error){console.error('Forest Party smoke test',error);document.documentElement.dataset.forestPartySmoke='FAIL'}})()}
  })();
  </script>
