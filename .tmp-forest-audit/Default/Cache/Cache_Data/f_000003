    function buildMiniZones(){els.miniArena.innerHTML=gameState.players.map((p,i)=>`<div class="mini-zone" data-player="${i}" style="--pc:${p.color}"><div class="mini-zone-label"><span class="player-dot"></span>${esc(p.name)}</div><div class="mini-zone-score" data-score="${i}">0</div><div class="zone-game" data-zone-game="${i}">준비!</div></div>`).join('')}
