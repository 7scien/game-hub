    function miniPointerEnd(event){miniSession?.pointers?.delete(event.pointerId)}
    function hitTarget(p,x,y,r=.19){const t=miniSession.targets[p];return Math.hypot(x-t.x,y-t.y)<r}
    function newTarget(p){miniSession.targets[p]={x:.18+rand()*.64,y:.22+rand()*.6}}
    function handleMiniInput(p,x,y){
      const s=miniSession;if(!s||performance.now()>s.end||performance.now()<s.lock[p]||(s.id==='tiebreak'&&!s.eligible.includes(p)))return;s.taps[p]++;
      if(s.id==='rapid'||s.id==='teamTap'||s.id==='tiebreak')s.scores[p]++;
      else if(s.id==='timing'||s.id==='teamTiming'){const marker=(Math.sin((performance.now()-s.start)/520+p*.8)+1)/2;s.scores[p]+=Math.max(0,Math.round(100-Math.abs(marker-.5)*200))}
      else if(s.id==='dodge')s.lanes[p]=x<.5?0:1;
      else if(s.id==='energy'){const zone=Math.min(2,Math.floor(x*3)),expected=s.sequences[p][s.seqIndex[p]];if(zone===expected){s.seqIndex[p]++;s.scores[p]++;if(s.seqIndex[p]>=4)s.seqIndex[p]=0}else{s.seqIndex[p]=0;s.lock[p]=performance.now()+450}}
