    function initialMiniScores(id,context){const scores=[0,0,0,0];if(id==='treasure'&&Number.isInteger(context.finderIndex))scores[context.finderIndex]=5;return scores}
    function playMini(id,def,context,teams,role){
      return new Promise(resolve=>{const now=performance.now(),scores=initialMiniScores(id,context);miniSession={id,def,context,teams,role,scores,taps:[0,0,0,0],start:now,end:now+def.seconds*1000,resolve,targets:Array.from({length:4},()=>({x:.25+rand()*.5,y:.25+rand()*.5})),sequences:Array.from({length:4},()=>id==='spirit'?shuffle([0,1,2,3]):[0,1,2,1]),seqIndex:[0,0,0,0],lock:[0,0,0,0],lanes:[0,0,0,0],obstacles:Array.from({length:4},()=>[]),lastSpawn:[now,now,now,now],gauge:50,finderShield:context.finderIndex,collisions:[0,0,0,0],pointers:new Map()};
        els.miniArena.addEventListener('pointerdown',miniPointer,{passive:false});els.miniArena.addEventListener('pointermove',miniPointerMove,{passive:false});els.miniArena.addEventListener('pointerup',miniPointerEnd);els.miniArena.addEventListener('pointercancel',miniPointerEnd);miniTick(now)
      })
    }
    function pointerCoordinates(event,zone,p){const r=zone.getBoundingClientRect();let x=(event.clientX-r.left)/r.width,y=(event.clientY-r.top)/r.height;if(p<2){x=1-x;y=1-y}return{p,x,y,zone}}
    function pointerData(event){const zone=event.target.closest('.mini-zone');if(!zone)return null;return pointerCoordinates(event,zone,Number(zone.dataset.player))}
    function miniPointer(event){event.preventDefault();const d=pointerData(event);if(!d||!miniSession)return;miniSession.pointers.set(event.pointerId,{p:d.p,zone:d.zone});try{d.zone.setPointerCapture(event.pointerId)}catch{};handleMiniInput(d.p,d.x,d.y)}
